# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ---- Node / frontend ----
node_modules/
frontend/dist/
frontend/.vite/
*.local

# ---- Generated data (reproducible; not source of truth) ----
data/generated/*
!data/generated/.gitkeep
artifacts/reports/*
!artifacts/reports/.gitkeep

# External real-flight data: raw downloads are NOT committed (size + licences);
# manifests (URL, bytes, SHA-256) and generated results ARE committed.
data/external/raw/
# Raw PX4 SITL captures (tlogs) are local evidence; manifests/results ARE committed.
data/sitl/raw/*.tlog
artifacts/external/**/feature_samples.npz

# Benchmark results + figures ARE committed as competition evidence
# (regenerable via `aegis benchmark`), so they are intentionally NOT ignored.

# demo screenshots: keep committed if present (video/demo evidence)
!demo/screenshots/

# ---- Databases / logs ----
*.sqlite
*.sqlite3
*.db
*.log

# ---- Trained models (regenerable via scripts/train_models.py / aegis train) ----
models/*.joblib
models/*.pkl

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
*.swp
*.tmp
*~
.idea/
.vscode/

.claude
CLAUDE.md